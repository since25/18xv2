# ── Server ──────────────────────────────────────────────────────────────
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────
# Docker/生产环境推荐 PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/organizer
# 如需继续使用 SQLite，可改回：
# DATABASE_URL=sqlite:///./data/storage_organizer.db
POSTGRES_DB=organizer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── 115 Open API credentials ─────────────────────────────────────────────
APP_ID=
APP_SECRET=
APP_REDIRECT_URI=

# ── 115 OAuth tokens (initial seed — refreshed tokens are stored in data/tokens.json) ──
# Obtain these via the /tools/qr-open-login flow in the web UI (device code flow).
ACCESS_TOKEN=
REFRESH_TOKEN=

# ── 115 API tuning ────────────────────────────────────────────────────────
API_MIN_INTERVAL_MS=800
API_MAX_RETRIES=2
API_RETRY_BACKOFF_MS=1200

# ── Execution safety ─────────────────────────────────────────────────────
DEFAULT_DRY_RUN=true
EXECUTOR_MAX_ITEMS_PER_RUN=20
# Comma-separated whitelisted 115 path prefixes for real execution
TEST_ALLOWED_PATH_PREFIXES=
TEST_ALLOWED_ROOT_IDS=

# ── Strategy rules ────────────────────────────────────────────────────────
RULES_FILE=examples/rules.yaml
STRATEGY_SOURCE=auto

# ── 115 offline download ──────────────────────────────────────────────────
OFFLINE_DEFAULT_TARGET_CID=3412729136586281899
OFFLINE_SUBMIT_INTERVAL_SECONDS=10
DUPLICATE_CHECK_SEARCH_LIMIT=10

# ── Single-admin auth ──────────────────────────────────────────────────────
AUTH_ENABLED=true
AUTH_USERNAME=wang
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=18x_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_HOURS=24
AUTH_TRUST_PROXY=true
AUTH_STORE_PATH=data/auth.json

# ── Local path presets (comma-separated) ─────────────────────────────────
LOCAL_PATH_PRESETS=

# ── External article source DB (optional) ────────────────────────────────
SOURCE_ARTICLE_DB_HOST=
SOURCE_ARTICLE_DB_PORT=5432
SOURCE_ARTICLE_DB_NAME=
SOURCE_ARTICLE_DB_USER=
SOURCE_ARTICLE_DB_PASSWORD=
SOURCE_ARTICLE_SEARCH_LIMIT=20

# ── RN Telegram downloader HTTP control plane ─────────────────────────
DOWNLOADER_ENABLED=false
DOWNLOADER_BASE_URL=
DOWNLOADER_PASSWORD=
DOWNLOADER_NODE_KEY=rn
DOWNLOADER_TIMEOUT_SECONDS=10
DOWNLOADER_SYNC_INTERVAL_SECONDS=60
# 任务进度单独同步的间隔（秒），不再排在资源包同步之后
DOWNLOADER_TASK_SYNC_INTERVAL_SECONDS=15

# ── Jellyfin 关键词合集 ──────────────────────────────────────────────────
# 只开 JELLYFIN_ENABLED 时可以扫描；同步合集还需要地址和 API Key
JELLYFIN_ENABLED=false
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=
JELLYFIN_TIMEOUT_SECONDS=15
JELLYFIN_PAGE_SIZE=500
# 每日自动扫描+同步的本地小时，-1 关闭
JELLYFIN_DAILY_RUN_HOUR=3
# 多个路径用逗号分隔；路径必须与 Jellyfin 容器内一致
MEDIA_LIBRARY_LOCAL_ROOTS=
MEDIA_LIBRARY_STRM_ROOTS=

# ── Misc ─────────────────────────────────────────────────────────────────
CLEANUP_MAX_DELETE_ITEMS=20
LOG_LEVEL=INFO
